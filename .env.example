# Set in Netlify: Site settings → Environment variables
ADMIN_PASSWORD=your-secure-password-here
NEXT_PUBLIC_BUSINESS_NAME=Perfect Platter

# Email (order confirmations) — Resend. https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Must use a domain you've verified at https://resend.com/domains
# (the default onboarding@resend.dev only delivers to your own Resend account email).
FROM_EMAIL=Perfect Platter <orders@yourdomain.com>
